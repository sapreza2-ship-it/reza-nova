{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reza-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5040ba6e-2e0b-4aba-9bfe-f25e9fd49eef","database_name": "reza-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "29ea7d21ce994e3abb88a0c6db71152b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
